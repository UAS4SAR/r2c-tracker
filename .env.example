# Local / workstation example for r2c-tracker.
# Copy to .env or .env.pilot.local (both gitignored) and fill values.
# Production and pilot deploy values live in Secret Manager — do not commit secrets.

# Required: separate operational and control-plane databases (never the same URL)
DATABASE_URL=sqlite+aiosqlite:///./tracker-dev.db
CONTROL_PLANE_DATABASE_URL=sqlite+aiosqlite:///./control-plane-dev.db

# HTTP
PORT=8080
TRACKER_PORT=8080

# Local release-check / admin defaults (override in real deploys)
SECRET_KEY=replace-me
DEPLOYMENT_GATE_KEY=replace-me
TRACKER_ADMIN_USER=admin
TRACKER_ADMIN_PASS=replace-me

# Optional local release-check overrides
# TRACKER_RELEASE_CHECK_HOST=127.0.0.1
# TRACKER_RELEASE_CHECK_PORT=18080
# R2C_RELEASE_TEST_DESIGNATOR=releasecheck

# FAA / OAuth / TURN / signing keys are normally injected from Secret Manager
# (see PILOT_SETUP.md). Prefer secret mounts over putting those values here.
